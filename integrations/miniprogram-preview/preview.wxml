<view class="preview"><view class="notice">运营草稿预览 · 不修改宠物进度或权益</view><input password value="{{token}}" bindinput="tokenInput" placeholder="输入后台生成的 15 分钟预览凭据" maxlength="64"/><button bindtap="load" loading="{{busy}}">加载预览</button><text>{{error}}</text><view wx:if="{{content}}"><picker range="{{appearanceNames}}" value="{{appearanceIndex}}" bindchange="selectAppearance"><view>造型：{{appearanceNames[appearanceIndex]}}</view></picker><picker range="{{expressions}}" bindchange="selectExpression"><view>表情：{{expression}}</view></picker><view class="stage"><image wx:if="{{background}}" class="background" src="{{background}}" mode="aspectFill"/><image wx:if="{{image}}" class="bird" src="{{image}}" mode="aspectFit"/></view></view></view>
